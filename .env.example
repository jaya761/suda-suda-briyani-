# ==============================================================
# SUDA SUDA BRIYANI - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your production/test keys
# ==============================================================

# Server Port (Default: 3000)
PORT=3000

# Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Razorpay Payment Gateway Credentials
# Found in: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Admin Authentication
# Default Master Admin account credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SudaSuda@2026
JWT_SECRET=suda_suda_briyani_secure_production_secret_change_me_9345372744
